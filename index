  members.forEach(function(m){if(!stMap[m.state])stMap[m.state]=[];stMap[m.state].push(m.age);});
  var stList=Object.keys(stMap).sort();
  var stMeans=stList.map(function(s){return mean(stMap[s]);});
  var minM=Math.min.apply(null,stMeans),maxM=Math.max.apply(null,stMeans);
  var tbody=document.getElementById("cad-state-tbody");
  stList.forEach(function(state){
    var a=stMap[state],m=mean(a),med=median(a),n=a.length,pct=((m-minM)/(maxM-minM))*100;
    var color="#888";
    var tr=document.createElement("tr");
    tr.innerHTML='<td class="state-name">'+state+'</td><td class="r"><div class="bar-cell"><span style="font-size:12px;font-weight:600;color:'+color+';">'+m.toFixed(1)+'</span><div class="bar-bg"><div class="bar-fill" style="width:'+pct.toFixed(1)+'%;background:'+color+';"></div></div></div></td><td class="r">'+med.toFixed(1)+'</td><td class="r">'+n+'</td><td class="r" style="color:#bbb;font-style:italic;">XX</td>';
    tbody.appendChild(tr);
  });

  var t=new Date();
  set("cad-updated","Ages calculated as of "+t.toLocaleDateString("en-US",{month:"long",day:"numeric",year:"numeric"})+". Updates automatically.");
})();
</script>
