<style>
.cad * { box-sizing: border-box; margin: 0; padding: 0; }
.cad { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 14px; color: #1a1a1a; line-height: 1.5; padding: 1.5rem 0; }
.cad .section-label { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; color: #888; text-transform: uppercase; margin-bottom: 10px; }
.cad .cubes-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 1.5rem; }
@media (max-width: 640px) { .cad .cubes-row { grid-template-columns: 1fr; } .cad .oldest-youngest { grid-template-columns: 1fr !important; } }
.cad .cube { background: #fff; border: 1px solid #e5e5e5; border-radius: 10px; padding: 1rem 1.25rem; }
.cad .cube-title { font-size: 12px; font-weight: 600; color: #555; margin-bottom: 10px; border-bottom: 1px solid #eee; padding-bottom: 8px; }
.cad .compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
.cad .compare-col { padding: 0 8px; }
.cad .compare-col:first-child { padding-left: 0; border-right: 1px solid #eee; }
.cad .compare-col:last-child { padding-right: 0; }
.cad .col-head { font-size: 11px; color: #aaa; margin-bottom: 6px; font-weight: 600; }
.cad .stat-row { display: flex; justify-content: space-between; align-items: baseline; padding: 3px 0; }
.cad .stat-lbl { font-size: 12px; color: #777; }
.cad .stat-val { font-size: 13px; font-weight: 600; color: #1a1a1a; }
.cad .stat-val.hi { color: #185FA5; }
.cad .stat-val.lo { color: #3B6D11; }
.cad .stat-val.muted { color: #bbb; font-style: italic; }
.cad .footnote { font-size: 11px; color: #aaa; margin-top: 10px; padding-top: 8px; border-top: 1px solid #eee; }
.cad .oldest-youngest { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 1.5rem; }
.cad .oy-cube { background: #fff; border: 1px solid #e5e5e5; border-radius: 10px; padding: 1rem 1.25rem; }
.cad .member-row { display: flex; justify-content: space-between; align-items: center; padding: 5px 0; border-bottom: 1px solid #f0f0f0; }
.cad .member-row:last-child { border-bottom: none; }
.cad .member-info { display: flex; flex-direction: column; gap: 1px; }
.cad .member-name { font-size: 12px; font-weight: 600; color: #1a1a1a; }
.cad .member-meta { font-size: 11px; color: #aaa; }
.cad .member-age { font-size: 13px; font-weight: 600; color: #555; min-width: 32px; text-align: right; }
.cad .party-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 3px; vertical-align: middle; }
.cad .dot-r { background: #C0392B; }
.cad .dot-d { background: #2471A3; }
.cad .dot-i { background: #888; }
.cad .state-table-wrap { border: 1px solid #e5e5e5; border-radius: 10px; overflow: hidden; }
.cad table { width: 100%; border-collapse: collapse; font-size: 12px; }
.cad thead th { background: #f7f7f7; font-weight: 600; font-size: 11px; color: #888; text-align: left; padding: 7px 10px; border-bottom: 1px solid #e5e5e5; }
.cad thead th.r { text-align: right; }
.cad tbody tr { border-bottom: 1px solid #f0f0f0; }
.cad tbody tr:last-child { border-bottom: none; }
.cad tbody tr:nth-child(even) { background: #fafafa; }
.cad tbody td { padding: 5px 10px; color: #1a1a1a; }
.cad tbody td.r { text-align: right; color: #777; }
.cad tbody td.state-name { font-weight: 600; }
.cad .bar-cell { display: flex; align-items: center; gap: 6px; justify-content: flex-end; }
.cad .bar-bg { width: 50px; height: 5px; background: #eee; border-radius: 3px; overflow: hidden; }
.cad .bar-fill { height: 100%; border-radius: 3px; }
.cad .updated { font-size: 11px; color: #bbb; margin-top: 1rem; }
</style>

